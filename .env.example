# Copy only the variables needed by each application and replace every
# angle-bracketed placeholder locally. Never commit populated values.

# AI and media integrations
GEMINI_API_KEY=<set-locally>
GEMINI_MODEL=<gemini-analysis-model>
GEMINI_IMAGE_MODEL=<gemini-image-model>
GEMINI_TTS_MODEL=<gemini-tts-model>
GEMINI_VOICE_NAME=<gemini-prebuilt-voice>
YOUTUBE_API_KEY=<set-locally>

# Persistence
DATABASE_URL=<postgresql-connection-string>
B2_APPLICATION_KEY_ID=<set-locally>
B2_APPLICATION_KEY=<set-locally>
B2_BUCKET_NAME=<bucket-name>
B2_ENDPOINT=<b2-s3-endpoint>
B2_REGION=<b2-region>

# Current application configuration
FRONTEND_URL=<frontend-origin>
APP_ENV=<development-or-staging-or-production>
NEXT_PUBLIC_API_BASE_URL=<backend-base-url>
